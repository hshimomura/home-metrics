                        "rawSql": "WITH latest AS (\n  SELECT DISTINCT ON (d.mac)\n    d.label,\n    sm.ts,\n    sm.temperature_c,\n    sm.soil_moisture_percent,\n    sm.conductivity_us_cm,\n    sm.lux\n  FROM sensor_minute sm\n  JOIN devices d ON d.mac = sm.mac\n  WHERE $__timeFilter(sm.ts)\n    AND d.sensor_category = 'Cisco Sensor Connect (IoT Orchestrator)'\n    AND (\n      sm.temperature_c IS NOT NULL OR\n      sm.soil_moisture_percent IS NOT NULL OR\n      sm.conductivity_us_cm IS NOT NULL OR\n      sm.lux IS NOT NULL\n    )\n  ORDER BY d.mac, sm.ts DESC\n)\nSELECT\n  label AS \"Plant\",\n  ts AS \"Last seen\",\n  round(temperature_c::numeric, 1) AS \"Temp C\",\n  round(soil_moisture_percent::numeric, 0) AS \"Soil moisture %\",\n  round(conductivity_us_cm::numeric, 0) AS \"Conductivity uS/cm\",\n  round(lux::numeric, 0) AS \"Lux\"\nFROM latest\nORDER BY label"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
