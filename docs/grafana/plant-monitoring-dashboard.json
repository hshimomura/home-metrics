            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "pve2-postgresql"
                      },
                      "group": "postgres",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "format": "time_series",
                        "rawQuery": true,
                        "rawSql": "WITH latest AS (\n  SELECT DISTINCT ON (d.mac)\n    d.label,\n    sm.ts,\n    sm.soil_moisture_percent\n  FROM sensor_minute sm\n  JOIN devices d ON d.mac = sm.mac\n  WHERE $__timeFilter(sm.ts)\n    AND d.sensor_category = 'Cisco Sensor Connect (IoT Orchestrator)'\n    AND sm.soil_moisture_percent IS NOT NULL\n  ORDER BY d.mac, sm.ts DESC\n)\nSELECT\n  ts AS \"time\",\n  label AS metric,\n  soil_moisture_percent AS value\nFROM latest\nORDER BY label"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
