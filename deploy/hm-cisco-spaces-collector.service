[Unit]
Description=Cisco Spaces Indoor IoT Firehose collector
After=postgresql.service network-online.target
Wants=postgresql.service network-online.target

[Service]
Type=simple
User=home_metrics
Group=home_metrics
WorkingDirectory=/var/lib/home-metrics
Environment=SENSOR_INGEST_SOURCE=cisco_spaces
Environment=CISCO_SPACES_FIREHOSE_URL=https://partners.dnaspaces.io/api/partners/v1/firehose/events
Environment=CISCO_SPACES_RECONNECT_MIN_DELAY=1s
Environment=CISCO_SPACES_RECONNECT_MAX_DELAY=60s
Environment=CISCO_SPACES_SAMPLE_WINDOW=5
Environment=CISCO_SPACES_FIELD_FRESHNESS=60s
Environment=CISCO_SPACES_UPLOAD_INTERVAL=60s
Environment=CISCO_SPACES_BATTERY_MODE=all
Environment=CISCO_SPACES_DRY_RUN=false
EnvironmentFile=-/etc/home-metrics/home-metrics.env
ExecStart=/usr/local/bin/hm-cisco-spaces-collector
Restart=always
RestartSec=10s

[Install]
WantedBy=multi-user.target
