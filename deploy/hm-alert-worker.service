[Unit]
Description=Home Metrics alert worker
After=postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=home_metrics
Group=home_metrics
WorkingDirectory=/var/lib/home-metrics
Environment=ALERT_WORKER_INTERVAL=1m
Environment=ALERT_WORKER_DRY_RUN=true
EnvironmentFile=-/etc/home-metrics/home-metrics.env
ExecStart=/usr/local/bin/hm-alert-worker
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
