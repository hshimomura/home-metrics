BLE_DB_DSN="dbname=ble_sensors host=/var/run/postgresql"

API_TOKEN=change-me
API_REQUIRE_TOKEN=false
API_ALLOWED_ORIGINS=http://localhost:8080
CISCO_SPACES_COLLECTOR_ENABLED=false

BLE_ADAPTER=/org/bluez/hci0
BLE_POLL_INTERVAL=2s
BLE_SENSORS_FILE=/etc/home-metrics/sensors.json

# Set this per collector when running commands directly outside Docker Compose.
# Use ble for hm-ble-collector and cisco_iot_orchestrator for
# hm-cisco-iot-orchestrator-collector.
SENSOR_INGEST_SOURCE=ble
CISCO_SPACES_API_KEY=
CISCO_SPACES_FIREHOSE_URL=https://partners.dnaspaces.io/api/partners/v1/firehose/events
CISCO_SPACES_RECONNECT_MIN_DELAY=1s
CISCO_SPACES_RECONNECT_MAX_DELAY=60s
CISCO_SPACES_STREAM_HEARTBEAT=60s
CISCO_SPACES_SAMPLE_WINDOW=5
CISCO_SPACES_FIELD_FRESHNESS=60s
CISCO_SPACES_UPLOAD_INTERVAL=60s
CISCO_SPACES_BATTERY_MODE=all
CISCO_SPACES_BATTERY_ALLOWLIST=
CISCO_SPACES_DRY_RUN=false
CISCO_SPACES_ALLOW_SECONDARY=false
CISCO_SPACES_DEBUG=false
CISCO_SPACES_PRUNE_CONFIGURED_BLE_SENSORS=true

CISCO_IOT_ORCH_API_URL=https://192.168.67.6:8081
CISCO_IOT_ORCH_MQTT_ADDR=192.168.67.6:41883
CISCO_IOT_ORCH_MQTT_MAX_PACKET_BYTES=1048576
CISCO_IOT_ORCH_ONBOARD_APP_ID=onboard
CISCO_IOT_ORCH_ONBOARD_API_KEY=
CISCO_IOT_ORCH_CONTROL_APP_ID=control
CISCO_IOT_ORCH_CONTROL_API_KEY=
CISCO_IOT_ORCH_DATA_APP_ID=data
CISCO_IOT_ORCH_DATA_API_KEY=
CISCO_IOT_ORCH_TOPIC=ioslab/home-metrics/ble/advertisements/v1
CISCO_IOT_ORCH_REGISTER_DATA_APP=false
CISCO_IOT_ORCH_DRY_RUN=false
CISCO_IOT_ORCH_DEBUG=false
CISCO_IOT_ORCH_STREAM_HEARTBEAT=60s
CISCO_IOT_ORCH_AGGREGATE_FLUSH_INTERVAL=10s
CISCO_IOT_ORCH_PENDING_LOG_INTERVAL=5m

COLLECTOR_STATUS_STALE_AFTER=5m

DB_MAINT_REFRESH_LOOKBACK=336h
DB_MAINT_RETAIN_MINUTE=336h

NATURE_REMO_TOKEN=
NATURE_REMO_INTERVAL=60s
NATURE_REMO_DEVICE_KEY=remo-e

ECHONET_TARGET_IP=
ECHONET_DEVICE_KEY=echonet-device
ECHONET_LOCAL_ADDR=:3610
ECHONET_POLL_INTERVAL=60s
ECHONET_REQUEST_TIMEOUT=3s

APCUPSD_SERVER=tcp://127.0.0.1:3551
APCUPSD_INTERVAL=60s
APCUPSD_TIMEOUT=5s
APCUPSD_DEVICE_KEY=ups
APCUPSD_LABEL="APC UPS"
APCUPSD_LOCATION=
